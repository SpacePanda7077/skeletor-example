{
  "name": "skeletor-example",
  "description": "Example game for the Skeletor Phaser plugin: a character controller, foot planting, IK arms, animation layers and more.",
  "version": "1.1.0",
  "scripts": {
    "dev": "vite --config vite/config.dev.mjs",
    "build": "tsc --noEmit && vite build --config vite/config.prod.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@dimforge/rapier2d-compat": "^0.21.0",
    "phaser": "4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "terser": "^5.28.1",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.26.1",
    "vite": "^6.3.1"
  },
  "private": true,
  "license": "MIT",
  "keywords": [
    "phaser",
    "phaser4",
    "skeletal-animation",
    "ik",
    "rapier",
    "react",
    "typescript"
  ]
}
