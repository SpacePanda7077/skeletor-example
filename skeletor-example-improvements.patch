diff --git a/public/style.css b/public/style.css
index 3c67ca6..b1048f5 100644
--- a/public/style.css
+++ b/public/style.css
@@ -1,48 +1,117 @@
+:root {
+    color-scheme: dark;
+    --bg: #0f1218;
+    --panel: #171b24;
+    --line: #2a3140;
+    --text: rgba(255, 255, 255, 0.87);
+    --muted: rgba(255, 255, 255, 0.5);
+    --accent: #4ade80;
+}
+
 body {
     margin: 0;
-    padding: 0;
-    color: rgba(255, 255, 255, 0.87);
-    background-color: #000000; 
-    font-family: Arial, Helvetica, sans-serif;
+    color: var(--text);
+    background: var(--bg);
+    font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
 }
 
 #app {
-    width: 100%;
-    height: 100vh;
-    overflow: hidden;
+    min-height: 100vh;
     display: flex;
     justify-content: center;
-    align-items: center;
+    align-items: flex-start;
+    gap: 16px;
+    padding: 16px;
+    box-sizing: border-box;
+}
+
+#game-container {
+    flex: none;
+    line-height: 0;
+    border: 1px solid var(--line);
+    border-radius: 8px;
+    overflow: hidden;
+}
+
+.panel {
+    width: 300px;
+    flex: none;
+    padding: 16px 18px;
+    background: var(--panel);
+    border: 1px solid var(--line);
+    border-radius: 8px;
+    font-size: 13px;
+    box-sizing: border-box;
+}
+
+.panel h1 { margin: 0; font-size: 20px; }
+.panel h2 {
+    margin: 18px 0 8px;
+    font-size: 11px;
+    letter-spacing: 0.08em;
+    text-transform: uppercase;
+    color: var(--muted);
+}
+.sub { margin: 2px 0 0; color: var(--muted); }
+
+code {
+    display: block;
+    margin-top: 2px;
+    font-size: 11px;
+    color: var(--accent);
+    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
 }
+kbd {
+    margin-left: 8px;
+    padding: 0 5px;
+    border: 1px solid var(--line);
+    border-radius: 4px;
+    font-size: 11px;
+    color: var(--muted);
+}
+
+dl { margin: 0; }
+.keys > div, .live > div {
+    display: flex;
+    justify-content: space-between;
+    padding: 3px 0;
+}
+dt { color: var(--muted); }
+dd { margin: 0; }
 
-.spritePosition {
-    margin: 10px 0 0 10px;
-    font-size: 0.8em;
+.toggle {
+    display: flex;
+    gap: 10px;
+    align-items: flex-start;
+    padding: 6px 0;
+    cursor: pointer;
 }
+.toggle input { margin-top: 3px; accent-color: var(--accent); }
+
+.slider { display: block; padding: 8px 0; }
+.slider input { width: 100%; margin-top: 6px; accent-color: var(--accent); }
+.slider b { margin-left: 6px; font-weight: 600; }
+
+.skins { padding: 8px 0; }
+.skins > div { display: flex; gap: 6px; margin-top: 6px; }
 
 .button {
-    width: 140px;
-    margin: 10px;
-    padding: 10px;
-    background-color: #000000;
-    color: rgba(255, 255, 255, 0.87);
-    border: 1px solid rgba(255, 255, 255, 0.87);
+    flex: 1;
+    padding: 6px 8px;
+    background: transparent;
+    color: var(--text);
+    border: 1px solid var(--line);
+    border-radius: 6px;
     cursor: pointer;
-    transition: all 0.3s;
-
-    &:hover {
-        border: 1px solid #0ec3c9;
-        color: #0ec3c9;
-    }
-
-    &:active {
-        background-color: #0ec3c9;
-    }
-
-    /* Disabled styles */
-    &:disabled {
-        cursor: not-allowed;
-        border: 1px solid rgba(255, 255, 255, 0.3);
-        color: rgba(255, 255, 255, 0.3);
-    }
-}
\ No newline at end of file
+    text-transform: capitalize;
+    transition: border-color 0.15s, color 0.15s;
+}
+.button:hover { border-color: var(--accent); color: var(--accent); }
+.button.active { background: var(--accent); border-color: var(--accent); color: #08110b; }
+
+.notes { margin: 0; padding-left: 18px; color: var(--muted); line-height: 1.6; }
+.notes code { display: inline; }
+
+@media (max-width: 1400px) {
+    #app { flex-direction: column; align-items: center; }
+}
